# Variables del entorno Docker local (compose.local.yaml).
# Copiar a .env.docker y generar valores propios solo para uso local:
#   APP_KEY:              echo "base64:$(openssl rand -base64 32)"
#   contraseñas de MySQL: openssl rand -hex 16
# DB_PASSWORD y MYSQL_PASSWORD deben coincidir.
# No usar la APP_KEY ni las credenciales de producción.

APP_NAME=LibreApp
# Con APP_ENV=production, AppServiceProvider fuerza https y los assets y
# formularios dejan de funcionar en http://localhost.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=libreapp
DB_USERNAME=libreapp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Usadas por el contenedor mysql:8.4
MYSQL_DATABASE=libreapp
MYSQL_USER=libreapp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
